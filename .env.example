TELEGRAM_BOT_TOKEN=

# Proton Mail Bridge (optional; use Bridge-generated credentials)
PROTON_IMAP_ADDRESS=127.0.0.1:1143
PROTON_SMTP_ADDRESS=127.0.0.1:1025
PROTON_BRIDGE_USERNAME=
PROTON_BRIDGE_PASSWORD=
PROTON_EMAIL_ADDRESS=
PROTON_TLS_SKIP_VERIFY=true

# Microsoft Graph (optional)
MICROSOFT_CLIENT_ID=
# Set true only when intentionally running the Microsoft first-time OAuth flow
ENABLE_MICROSOFT_OAUTH=false
